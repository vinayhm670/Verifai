# VERIFAI Environment Configuration
# Copy this file to .env.local and fill in your values

# Supabase Project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (Settings → API → Project API keys → anon public)
SUPABASE_ANON_KEY=your-anon-public-key-here

# WARNING: Never use the service_role key in client-side code!
# SUPABASE_SERVICE_ROLE_KEY=do-not-use-in-frontend
