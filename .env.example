# Verifai Trust & Scam Detection Platform — Environment Configuration
# GEMINI_API_KEY: Configured for server-side AI forensic analysis
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base URL of the deployment (injected by host or localhost in dev)
APP_URL="http://localhost:3000"

# Optional External Database (Cloud SQL / PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/verifai"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional Alternative AI & LLM Providers
ANTHROPIC_API_KEY="your-anthropic-key"

# Optional Google OAuth (Only when configured in Cloud Console)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Allowed CORS Origins
CORS_ORIGINS="http://localhost:3000"
